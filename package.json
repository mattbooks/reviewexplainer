{
  "name": "reviewexplainer",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/format && tsc -p packages/core && tsc -p packages/cli && tsc -p packages/pi-extension && tsc -p packages/watch && tsc -p packages/viewer",
    "dev": "npm run dev -w @reviewexplainer/viewer",
    "build": "npm run build -w @reviewexplainer/viewer",
    "greview": "node packages/cli/bin/greview.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
